{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/pre-bash-safety.sh"
      },
      {
        "command": ".cursor/hooks/pre-commit-check.sh",
        "matcher": "git.*commit"
      },
      {
        "command": ".cursor/hooks/pre-memory-push.sh",
        "matcher": "git[[:space:]].*push.*ai-memory"
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/pre-edit-check.sh"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/stop-verify.sh"
      }
    ]
  }
}
