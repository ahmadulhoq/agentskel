{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": ".github/hooks/pre-commit-check.sh",
        "comment": "Block commit without CHANGELOG/TIME_LOG",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": ".github/hooks/pre-memory-push.sh",
        "comment": "Auto-pull before ai-memory push",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": ".github/hooks/stop-verify.sh",
        "comment": "Verify task-completion before finishing",
        "timeoutSec": 10
      }
    ]
  }
}
