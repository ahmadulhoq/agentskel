{
  "permissions": {
    "_note": "Read-only patterns and safe project-scoped write/git ops. Destructive patterns (--force, --hard, rm -rf, branch -D, checkout -- <file>) are matched but blocked by pre-bash-safety.sh regardless of this allowlist. See docs/AUTONOMY-MODES.md.",
    "allow": [
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(git log*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git remote*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git config --get *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git stash*)",
      "Bash(git worktree*)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh api *)",
      "Edit(**)",
      "Write(**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-bash-safety.sh"
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": ".claude/hooks/pre-commit-check.sh"
          },
          {
            "type": "command",
            "if": "Bash(git*push*ai-memory*)",
            "command": ".claude/hooks/pre-memory-push.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-edit-check.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-edit-check.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/stop-verify.sh"
          }
        ]
      }
    ]
  }
}
